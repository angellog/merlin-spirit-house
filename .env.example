# ---------------------------------------------------------------------------
# Merlin Spirit House — environment configuration
#
# Copy to `.env.local` for local work. On cPanel, enter these in the
# "Setup Node.js App" screen under Environment Variables.
#
# The NEXT_PUBLIC_* values are inlined into the JavaScript bundle AT BUILD
# TIME, not read at boot. Changing one means rebuilding and re-uploading.
# Never put a secret in a NEXT_PUBLIC_* var: it ships to the browser.
# ---------------------------------------------------------------------------

# --- REQUIRED: practitioner details ----------------------------------------
# These fill in the headline, hero copy, footer and WhatsApp button. 35 of the
# 87 usages have no fallback, so leaving these blank renders empty gaps in the
# sales copy ("For years, has reunited..." with no name) rather than an error.
NEXT_PUBLIC_CLIENT_NAME=Ndaula
NEXT_PUBLIC_CLIENT_TITLE=Prof.
NEXT_PUBLIC_CLIENT_TAGLINE=Traditional Healer & Voodoo Practitioner
# Body copy on 10 pages hardcodes "13 years". Keep this at 13 or the hero
# stat and the page text will contradict each other in front of visitors.
NEXT_PUBLIC_CLIENT_YEARS=13
NEXT_PUBLIC_CLIENT_LOCATION=Kampala, Uganda

# Full international format, digits only, no "+" or spaces — this is used to
# build the wa.me link, which silently fails on a malformed number.
NEXT_PUBLIC_CLIENT_WHATSAPP=256788546704
# NOTE: the codebase hardcodes TWO different addresses --
# info@merlinspirithouse.com and contact@merlinspirithouse.com.
# Confirm which mailbox actually exists before launch.
NEXT_PUBLIC_CLIENT_EMAIL=contact@merlinspirithouse.com

# --- REQUIRED: canonical site URL ------------------------------------------
# Used for canonical tags, OpenGraph URLs and the sitemap. Must be the live
# https:// origin with no trailing slash. A wrong value here points search
# engines and social previews at a domain you do not control.
# NOTE: next-sitemap.config.js currently hardcodes https://merlinspirithouse.com
# — change it there too if the real domain differs.
NEXT_PUBLIC_SITE_URL=https://merlinspirithouse.com

# --- OPTIONAL: Sanity CMS --------------------------------------------------
# The site builds and runs fine without these: src/sanity/lib/client.ts has an
# `isConfigured` guard that returns a null client and stub image builder, so
# pages fall back to the bundled MDX content in /content.
# Set them to drive content from Sanity instead.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only (NOT NEXT_PUBLIC) — safe to hold real secrets.
# Read token is only needed for draft/preview content.
SANITY_API_READ_TOKEN=
SANITY_API_TOKEN=

# Shared secret for the /api/revalidate webhook. Generate a long random
# string; without it that endpoint should not be exposed publicly.
SANITY_REVALIDATE_SECRET=

# --- OPTIONAL: analytics & chat -------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_JIVOCHAT_WIDGET_ID=
